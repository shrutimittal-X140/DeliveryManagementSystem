<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="WebUI.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - DeliveryERP</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #080a14;
            color: #e2e8f0;
        }

        .navbar-custom {
            background-color: #0b0e1b;
            border-bottom: 1px solid #1e293b;
            padding: 0.85rem 2rem;
        }

        .brand-logo-container {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-icon-wrapper {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 1.5rem;
        }

        .brand-icon-wrapper .truck-icon { color: #ffffff; }
        .brand-icon-wrapper .chevron-icon { color: #22c55e; font-weight: 900; font-size: 1.3rem; }

        .navbar-brand-text {
            font-weight: 800;
            font-size: 1.6rem;
            color: #ffffff;
            letter-spacing: -0.03em;
            margin-bottom: 0;
            line-height: 1;
        }

        .navbar-brand-text span { color: #22c55e; font-weight: 800; }

        /* Menu Trigger Button */
        .btn-menu-toggle {
            background-color: #0f172a;
            border: 1px solid #1e293b;
            color: #ffffff;
            padding: 0.5rem 0.85rem;
            border-radius: 8px;
            font-size: 1.1rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .btn-menu-toggle:hover {
            background-color: #1e293b;
            color: #22c55e;
            border-color: #334155;
        }

        /* Sliding Offcanvas Drawer Styling */
        .offcanvas-dark {
            background-color: #0b0e1b !important;
            border-right: 1px solid #1e293b !important;
            width: 280px !important;
        }

        .offcanvas-header {
            border-bottom: 1px solid #1e293b;
            padding: 1.25rem 1.5rem;
        }

        .offcanvas-title {
            color: #ffffff;
            font-weight: 800;
            font-size: 1.2rem;
        }

        .btn-close-white {
            filter: invert(1) grayscale(100%) brightness(200%);
        }

        .sidebar-menu {
            list-style: none;
            padding: 1rem 0.75rem;
            margin: 0;
        }

        .sidebar-menu li {
            margin-bottom: 4px;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0.75rem 1rem;
            color: #94a3b8;
            font-weight: 600;
            font-size: 0.95rem;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .sidebar-menu a:hover, .sidebar-menu a.active {
            background-color: rgba(34, 197, 94, 0.1);
            color: #22c55e;
        }

        .sidebar-menu a i {
            width: 20px;
            text-align: center;
            font-size: 1rem;
        }

        .btn-nav-green {
            background-color: #22c55e;
            color: #0b0e1b !important;
            font-weight: 700;
            padding: 0.55rem 1.25rem;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-nav-green:hover {
            background-color: #16a34a;
            transform: translateY(-1px);
        }
    </style>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form runat="server">
        <!-- Top Header Navigation -->
        <nav class="navbar navbar-custom sticky-top">
            <div class="container-fluid d-flex align-items-center justify-content-between">
                
                <div class="d-flex align-items-center gap-3">
             
                    <button type="button" class="btn-menu-toggle" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu">
                        <i class="fa-solid fa-bars"></i>
                        <span class="d-none d-sm-inline style-menu-lbl">Menu</span>
                    </button>

                    <a class="brand-logo-container" href="Default.aspx">
                        <div class="brand-icon-wrapper">
                            <i class="fa-solid fa-truck-fast truck-icon"></i>
                            <i class="fa-solid fa-chevron-right chevron-icon"></i>
                        </div>
                        <span class="navbar-brand-text">Delivery<span>ERP</span></span>
                    </a>
                </div>

                <div class="d-flex align-items-center">
                    <% if (Session["UserId"] == null) { %>
                        <a href="TrackDelivery.aspx" class="text-secondary text-decoration-none me-3 d-none d-sm-inline font-weight-bold">Track Delivery</a>
                        <a href="Login.aspx" class="btn-nav-green">Get Started</a>
                    <% } else { %>
                        <span class="text-white small me-3">
                            <i class="fa-solid fa-circle-user text-success me-1"></i>
                            <%= Session["Username"] ?? Session["FullName"] ?? "User" %>
                        </span>
                        <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-outline-light btn-sm rounded-3" OnClick="btnLogout_Click">
                            Logout
                        </asp:LinkButton>
                    <% } %>
                </div>

            </div>
        </nav>

        <div class="offcanvas offcanvas-start offcanvas-dark" tabindex="-1" id="sidebarMenu">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title d-flex align-items-center gap-2">
                    <i class="fa-solid fa-compass text-success"></i> Navigation
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body p-0">
                <ul class="sidebar-menu">
                    <% if (Session["UserId"] != null) { %>
                        <li><a href="Default.aspx"><i class="fa-solid fa-house"></i> Home</a></li>
                        <li><a href="Dashboard.aspx"><i class="fa-solid fa-chart-pie"></i> Dashboard</a></li>
                        <li><a href="DeliveryManagement.aspx"><i class="fa-solid fa-box-archive"></i> Deliveries</a></li>
                        <li><a href="DriverManagement.aspx"><i class="fa-solid fa-id-card"></i> Drivers</a></li>
                        <li><a href="CustomerManagement.aspx"><i class="fa-solid fa-users"></i> Customers</a></li>
                        <li><a href="SearchReports.aspx"><i class="fa-solid fa-file-invoice"></i> Reports</a></li>
                        <li><a href="ItemManagement.aspx"><i class="fa-solid fa-cubes"></i> Items</a></li>
                        <li><a href="DriverWorkload.aspx"><i class="fa-solid fa-truck-ramp-box"></i> Workload</a></li>
                        <li><a href="TrackDelivery.aspx"><i class="fa-solid fa-magnifying-glass-location"></i> Track Delivery</a></li>
                    <% } else { %>
                        <li><a href="Default.aspx"><i class="fa-solid fa-house"></i> Home</a></li>
                        <li><a href="TrackDelivery.aspx"><i class="fa-solid fa-magnifying-glass-location"></i> Track Delivery</a></li>
                        <li><a href="Login.aspx"><i class="fa-solid fa-right-to-bracket"></i> Login</a></li>
                    <% } %>
                </ul>
            </div>
        </div>

        <div class="container-fluid px-lg-5 px-4 py-4">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <asp:ContentPlaceHolder ID="ScriptContent" runat="server"></asp:ContentPlaceHolder>
</body>
</html>