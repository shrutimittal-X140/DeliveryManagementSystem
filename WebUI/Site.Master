<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="WebUI.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - DeliveryERP</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #080a14;
            color: #e2e8f0;
        }

        .navbar-custom {
            background-color: #0b0e1b;
            border-bottom: 1px solid #1e293b;
            padding: 1rem 2.5rem;
        }

        .brand-logo-container {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-icon-wrapper {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 1.75rem;
        }

        .brand-icon-wrapper .truck-icon {
            color: #ffffff;
        }

        .brand-icon-wrapper .chevron-icon {
            color: #22c55e;
            font-weight: 900;
            font-size: 1.5rem;
        }

        .navbar-brand-text {
            font-weight: 800;
            font-size: 1.85rem;
            color: #ffffff;
            letter-spacing: -0.03em;
            margin-bottom: 0;
            line-height: 1;
        }

        .navbar-brand-text span {
            color: #22c55e;
            font-weight: 800;
        }

        .nav-link {
            color: #94a3b8 !important;
            font-weight: 600;
            font-size: 1rem;
            margin: 0 0.6rem;
            transition: all 0.2s ease;
        }

        .nav-link:hover, .nav-link.active {
            color: #ffffff !important;
        }

        .btn-nav-green {
            background-color: #22c55e;
            color: #0b0e1b !important;
            font-weight: 700;
            padding: 0.6rem 1.4rem;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-nav-green:hover {
            background-color: #16a34a;
            transform: translateY(-1px);
        }
    </style>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form runat="server">
        <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
            <div class="container-fluid">
                <a class="brand-logo-container" href="Default.aspx">
                    <div class="brand-icon-wrapper">
                        <i class="fa-solid fa-truck-fast truck-icon"></i>
                        <i class="fa-solid fa-chevron-right chevron-icon"></i>
                    </div>
                    <span class="navbar-brand-text">Delivery<span>ERP</span></span>
                </a>

                <button class="navbar-toggler text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <%-- Display header options ONLY when user is logged in --%>
                    <% if (Session["UserId"] != null) { %>
                        <ul class="navbar-nav ms-auto align-items-center me-4">
                            <li class="nav-item"><a class="nav-link" href="Default.aspx">Home</a></li>
                            <li class="nav-item"><a class="nav-link" href="Dashboard.aspx">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" href="DeliveryManagement.aspx">Deliveries</a></li>
                            <li class="nav-item"><a class="nav-link" href="DriverManagement.aspx">Drivers</a></li>
                            <li class="nav-item"><a class="nav-link" href="CustomerManagement.aspx">Customers</a></li>
                            <li class="nav-item"><a class="nav-link" href="SearchReports.aspx">Reports</a></li>
                        </ul>
                    <% } else { %>
                        <div class="ms-auto"></div>
                    <% } %>

                    <div class="d-flex align-items-center">
                        <% if (Session["UserId"] == null) { %>
                            <a href="Login.aspx" class="btn-nav-green">Get Started</a>
                        <% } else { %>
                            <span class="text-white small me-3">
                                <i class="fa-solid fa-circle-user text-success me-1"></i> 
                                <%= Session["Username"] ?? Session["FullName"] ?? "User" %>
                            </span>
                            <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-outline-light btn-sm rounded-3" OnClick="btnLogout_Click">
                                Logout
                            </asp:LinkButton>
                        <% } %>
                    </div>
                </div>
            </div>
        </nav>

        <div class="container-fluid px-lg-5 px-4 py-4">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <asp:ContentPlaceHolder ID="ScriptContent" runat="server"></asp:ContentPlaceHolder>
</body>
</html>